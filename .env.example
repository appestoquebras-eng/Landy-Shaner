# =========================================================================
# VARIÁVEIS DE AMBIENTE - LANDY SHANER & SIGILO PAY
# =========================================================================

# GEMINI_API_KEY: Injetada automaticamente pelo AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública onde a aplicação está hospedada
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------------
# FRONTEND CLOUDFLARE PAGES (VARIÁVEL PÚBLICA)
# Em produção no Cloudflare Pages, defina para apontar para a Edge Function:
# https://ojvznzupiojimykqryhw.supabase.co/functions/v1/checkout-api
# Se deixado em branco, utiliza o backend local /api
# -------------------------------------------------------------------------
VITE_CHECKOUT_API_URL="https://ojvznzupiojimykqryhw.supabase.co/functions/v1/checkout-api"

# -------------------------------------------------------------------------
# SIGILO PAY (EXCLUSIVAS DO SERVIDOR / EDGE FUNCTION - NUNCA EXPOR NO FRONTEND)
# Obtenha suas credenciais no painel oficial da Sigilo Pay em https://app.sigilopay.com.br
# -------------------------------------------------------------------------
SIGILOPAY_PUBLIC_KEY="sua_chave_publica_sigilopay_aqui"
SIGILOPAY_SECRET_KEY="sua_chave_secreta_sigilopay_aqui"
# A URL de callback deve ser pública e HTTPS apontando para /api/webhooks/sigilopay
# Atenção: Mantenha a mesma URL em todas as cobranças (limite de 20 URLs no gateway)
SIGILOPAY_CALLBACK_URL="https://seu-dominio.com.br/api/webhooks/sigilopay"

# -------------------------------------------------------------------------
# SUPABASE (BANCO DE DADOS & SEGURANÇA COM RLS)
# O service_role é usado estritamente pelo backend Node.js para ler e gravar pedidos.
# NUNCA insira a service_role_key em variáveis com prefixo VITE_*!
# -------------------------------------------------------------------------
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta_aqui"

# Opcionais para frontend (caso utilize autenticação de usuário final)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_anon_key_publica_aqui"
